# Required when using Postgres. On Railway use the private DATABASE_URL (reference from Postgres service) to avoid egress fees.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Optional: server port (default 3000). Railway sets PORT automatically.
# PORT=3000

# Optional: CORS allowed origin (e.g. https://scheduler.shofar.ai)
# ALLOWED_ORIGIN=
